# AIOS environment — copy to .env at the repo root and fill in what you use.
# .env and .env.local are gitignored (and reading them is denied in
# .claude/settings.json). Never commit a real .env.
#   cp .env.example .env
#
# The AIOS core needs NO env vars. Everything below is per-feature/optional.

# --- video-use (optional video editor skill) ---------------------------------
# ElevenLabs API key for transcription (Scribe STT). Get one at
# https://elevenlabs.io/app/settings/api-keys
# IMPORTANT: a root .env / .env.local is NOT auto-loaded — the skill won't see
# it. Put the key in ONE of these two places instead:
#   1. export ELEVENLABS_API_KEY=... in your shell (e.g. ~/.bashrc), or
#   2. .claude/skills/video-use/.env  (the skill reads this directly)
ELEVENLABS_API_KEY=
