# video-use environment — copy to .env in this same directory and fill in.
# .env is gitignored (never commit it). chmod 600 after creating.
#   cp .env.example .env && chmod 600 .env

# Required: ElevenLabs API key for transcription (Scribe STT — word-level
# timestamps, speaker diarization, filler tagging). A single secret token.
# Get one at https://elevenlabs.io/app/settings/api-keys
# Alternatively, export ELEVENLABS_API_KEY in your shell; the skill reads the
# env var before falling back to this .env.
ELEVENLABS_API_KEY=
