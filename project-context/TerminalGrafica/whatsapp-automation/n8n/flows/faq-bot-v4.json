      "id": "4d5e6f7a-8b9c-0123-4d5e-6f7a8b9c0123",
      "name": "Get Historial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Chatwoot API Token"
        }
      }
