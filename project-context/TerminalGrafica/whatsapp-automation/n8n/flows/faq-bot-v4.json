    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const armPrompt = $('Armar Prompt').item.json;\nconst conversationMsgs = armPrompt.llmMessages.filter(m => m.role !== 'system');\n\nconst noteMessages = [\n  {\n    role: 'system',\n    content: `Generá una nota interna breve para el equipo de Terminal Gráfica sobre esta consulta de WhatsApp.\nIncluí:\n- Qué quiere el cliente (una línea)\n- Datos mencionados (producto, cantidad, fecha, medida, etc.) — solo los que el cliente dijo explícitamente\n- Próximo paso sugerido para el asesor\n\nMáximo 5 líneas. Tono directo, para uso interno. No incluyas la palabra ESCALAR.`\n  },\n  ...conversationMsgs\n];\n\nreturn [{\n  json: {\n    noteMessages,\n    conversationId: armPrompt.conversationId,\n    accountId: armPrompt.accountId\n  }\n}];"
