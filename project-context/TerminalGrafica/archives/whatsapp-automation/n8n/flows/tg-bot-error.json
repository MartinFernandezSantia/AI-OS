    "nodes": [
        {
            "parameters": {},
            "id": "e1a2b3c4-d5e6-4f70-8a91-0b1c2d3e4f50",
            "name": "Error Trigger",
            "type": "n8n-nodes-base.errorTrigger",
            "typeVersion": 1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "// El Error Trigger recibe del engine el objeto estándar de error de la\n// ejecución fallida. Extraemos defensivamente (con fallbacks) los campos útiles\n// para diagnosticar. El conversation_id NO viene en este payload: se recupera\n// abriendo execution_url en n8n.\nconst j = $input.first().json || {};\nconst ex = j.execution || {};\nconst wf = j.workflow || {};\nconst err = ex.error || {};\nconst s = (v, n) => String(v == null ? '' : v).slice(0, n);\n\nreturn [{\n  json: {\n    workflow_name: s(wf.name, 200),\n    failed_node:     s(ex.lastNodeExecuted, 200),\n    message:         s(err.message, 2000),\n    stack:           s(err.stack, 4000),\n    execution_id:    s(ex.id, 100),\n    execution_url:   s(ex.url, 500),\n    mode:            s(ex.mode, 50),\n  },\n}];\n"
            },
            "id": "a2b3c4d5-e6f7-4081-9a02-1b2c3d4e5f61",
            "name": "Armar Error",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                224,
                0
            ]
        },
        {
            "parameters": {
                "schema": {
                    "__rl": true,
                    "value": "bot",
                    "mode": "list"
                },
                "table": {
                    "__rl": true,
                    "value": "errors",
                    "mode": "list"
                },
                "columns": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "workflow_name": "={{ $json.workflow_name }}",
                        "failed_node": "={{ $json.failed_node }}",
                        "message": "={{ $json.message }}",
                        "stack": "={{ $json.stack }}",
                        "execution_id": "={{ $json.execution_id }}",
                        "execution_url": "={{ $json.execution_url }}",
                        "mode": "={{ $json.mode }}"
                    },
                    "matchingColumns": [],
                    "schema": []
                },
                "options": {}
            },
            "id": "b3c4d5e6-f708-4192-8a13-2c3d4e5f6072",
