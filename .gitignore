.env
.env.local
.DS_Store
*.log
__pycache__/
node_modules/
audits/
projects/*

# Generated AI asset drafts — keep finals, ignore throwaway iterations
project-context/**/assets/drafts/

# Throwaway/temp artifacts (QR pngs, tunnel logs, scratch files) — never commit
temp/
tmp/
