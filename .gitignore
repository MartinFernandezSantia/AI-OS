# QR generation venv (local tooling)
.qr-venv/

# Supabase CLI ephemeral state (supabase link droppings)
**/supabase/.temp/

# volcados temporales de ejecuciones n8n para debug
project-context/TerminalGrafica/whatsapp-automation/n8n/flows/.tmp/

# Derivados regenerables por tools/resize-zonaprop.sh
project-context/**/zonaprop/

# Locks de LibreOffice/Excel: aparecen mientras un archivo está abierto
.~lock.*#

# TG whatsapp-rag — catálogos transitorios / copias cliente / backups de LibreOffice
